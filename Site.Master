<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="Atelier.SiteMaster" %>

<!DOCTYPE html>

<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Atelier. One Platform. Endless Creativity.</title>

    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
    <link href="~/Content/Site.css" rel="stylesheet" type="text/css" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />

    </head>
    <body>

        <form id="form1" runat="server">

        <asp:ScriptManager runat="server">
            <Scripts>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
                
            </Scripts>
        </asp:ScriptManager>

            <div id="navbar">
                <div id="nav-brand">
                    <a href="~/Default.aspx" runat="server" style="display:inline-flex;align-items:center;gap:8px;">
                        <img src="~/Images/atelier-sparkle.png" runat="server" alt="Sparkle Icon" style="height:24px;width:24px;object-fit:contain;vertical-align:middle;" />
                        <span id="nav-title">Atelier</span> 
                    </a>
                </div>
                <div id="nav-links">

                    <% if (Session["firstName"] != null) { %>

                        <% if (Session["Role"] != null && 
                               Session["Role"].ToString() == "Admin") { %>
                            <a href="~/Default.aspx" runat="server">Home</a>
                            <a href="~/Admin/Dashboard.aspx" runat="server">Dashboard</a>
                            <a href="~/Courses.aspx" runat="server">Courses</a>
                            <a href="~/Forum.aspx" runat="server">Forum</a>
                            <a href="~/Leaderboard.aspx" runat="server">Leaderboard</a>
                            <span id="welcome-msg" style="display:inline-flex;align-items:center;gap:5px;">
                                <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="vertical-align:-2px;"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                                Hi, <%= Session["firstName"].ToString() %>
                            </span>
                            <a href="~/Logout.aspx" runat="server" style="display:inline-flex;align-items:center;gap:4px;">
                                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="vertical-align:-2px;"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                                Sign Out
                            </a>

                        <% } else { %>
                            <a href="~/Default.aspx" runat="server">Home</a>
                            <a href="~/Courses.aspx" runat="server">Courses</a>
                            <a href="~/Forum.aspx" runat="server">Forum</a>
                            <a href="~/Leaderboard.aspx" runat="server">Leaderboard</a>
                            <a href="~/FAQ.aspx" runat="server">FAQ</a>
                            <a href="~/Dashboard.aspx" runat="server">Dashboard</a>
                            <span id="welcome-msg" style="display:inline-flex;align-items:center;gap:5px;">
                                <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="vertical-align:-2px;"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                                Hi, <%= Session["firstName"].ToString() %>
                            </span>
                            <a href="~/Logout.aspx" runat="server" style="display:inline-flex;align-items:center;gap:4px;">
                                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="vertical-align:-2px;"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                                Sign Out
                            </a>

                        <% } %>

                    <% } else { %>
                        <a href="~/Default.aspx" runat="server">Home</a>
                        <a href="~/Courses.aspx" runat="server">Courses</a>
                        <a href="~/Forum.aspx" runat="server">Forum</a>
                        <a href="~/Leaderboard.aspx" runat="server">Leaderboard</a>
                        <a href="~/FAQ.aspx" runat="server">FAQ</a>
                        <a href="~/Inquiry.aspx" runat="server">Contact</a>
                        <a href="~/Login.aspx" runat="server">Sign In</a>
                        <a href="~/Register.aspx" runat="server" 
                           class="btn-register">Register</a>

                    <% } %>

                   <button id="dark-toggle" 
        type="button"
        onclick="toggleDark()">Dark Mode</button>

                </div>
            </div>

               <div id="main-content">
                   <asp:ContentPlaceHolder ID="MainContent" runat="server"/>
                   </div>
                </form>

<div id="footer">
    <p>
        &copy; <%= DateTime.Now.Year %> 
        Atelier. One Platform. Endless Creativity.
    </p>
    <p style="margin-top:8px;font-size:12px">
        Visual Arts &nbsp;|&nbsp; 
        Digital Art &nbsp;|&nbsp; 
        Photography &nbsp;|&nbsp; 
        Film &amp; Video &nbsp;|&nbsp; 
        Music
    </p>
</div>

    <%-- AI Helpdesk / Chatbot Floating Widget --%>
    <div id="ai-chatbot-widget" style="position:fixed;bottom:24px;right:24px;z-index:9999;font-family:'Inter',system-ui,sans-serif;">
        <!-- Chatbot Floating Button -->
        <button id="ai-chat-btn" onclick="toggleAIChat()" style="background:#6B1A2A;color:#FFFFFF;border:none;padding:14px 22px;border-radius:9999px;box-shadow:0 10px 30px rgba(107,26,42,0.4);cursor:pointer;display:flex;align-items:center;gap:10px;font-weight:600;font-size:15px;transition:transform 0.2s ease,box-shadow 0.2s ease;">
            <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
            <span>AI Assistant</span>
            <span style="background:#D4AF37;color:#1A0A0E;font-size:11px;font-weight:800;padding:2px 7px;border-radius:10px;margin-left:2px;">AI</span>
        </button>

        <!-- Chatbot Window -->
        <div id="ai-chat-window" style="display:none;width:380px;height:530px;background:#FFFFFF;border:1px solid #E2E8F0;border-radius:20px;box-shadow:0 16px 48px rgba(0,0,0,0.2);position:absolute;bottom:70px;right:0;flex-direction:column;overflow:hidden;transition:all 0.3s ease;">
            <!-- Header -->
            <div style="background:#6B1A2A;color:#FFFFFF;padding:16px 20px;display:flex;align-items:center;justify-content:space-between;">
                <div style="display:flex;align-items:center;gap:10px;">
                    <div style="width:36px;height:36px;border-radius:50%;background:rgba(255,255,255,0.2);display:flex;align-items:center;justify-content:center;color:#FFFFFF;">
                        <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2L9.5 9.5 2 12l7.5 2.5L12 22l2.5-7.5L22 12l-7.5-2.5z"/></svg>
                    </div>
                    <div>
                        <strong style="font-size:15px;display:block;color:#FFFFFF;font-weight:700;">Atelier AI Helpdesk</strong>
                        <span style="font-size:12px;color:rgba(255,255,255,0.9);display:flex;align-items:center;gap:4px;">
                            <span style="width:7px;height:7px;border-radius:50%;background:#10B981;display:inline-block;"></span> Online & Ready to Help
                        </span>
                    </div>
                </div>
                <button onclick="toggleAIChat()" style="background:transparent;border:none;color:#FFFFFF;font-size:22px;cursor:pointer;padding:0 6px;line-height:1;">&times;</button>
            </div>

            <!-- Messages Body -->
            <div id="ai-chat-messages">
                <!-- Bot Welcome Message -->
                <div style="display:flex;gap:10px;align-items:flex-start;">
                    <div style="width:32px;height:32px;border-radius:50%;background:#6B1A2A;color:#FFFFFF;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                        <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2L9.5 9.5 2 12l7.5 2.5L12 22l2.5-7.5L22 12l-7.5-2.5z"/></svg>
                    </div>
                    <div class="ai-bot-bubble">
                        Hello! Welcome to <strong>Atelier</strong>. I am your AI assistant! How can I help you navigate the platform or get the most out of your creative journey today?
                    </div>
                </div>
            </div>

            <!-- Persistent Quick Prompts Bar (Always Available) -->
            <div id="ai-quick-prompts">
                <button class="ai-quick-btn" onclick="sendQuickPrompt('How do I earn a certificate?')">
                    <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="vertical-align:-1px;margin-right:4px;"><path d="M12 15l-2 5l2-1.5l2 1.5l-2-5z"/><circle cx="12" cy="9" r="6"/></svg>
                    Earn Certificate
                </button>
                <button class="ai-quick-btn" onclick="sendQuickPrompt('Where is the Leaderboard and XP?')">
                    <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="vertical-align:-1px;margin-right:4px;"><path d="M6 9H3a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1V10a1 1 0 0 0-1-1zm8-5h-3a1 1 0 0 0-1 1v15a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1V5a1 1 0 0 0-1-1zm8 9h-3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-6a1 1 0 0 0-1-1z"/></svg>
                    Leaderboard & XP
                </button>
                <button class="ai-quick-btn" onclick="sendQuickPrompt('How to enroll in courses?')">
                    <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="vertical-align:-1px;margin-right:4px;"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                    Courses & Enrolling
                </button>
                <button class="ai-quick-btn" onclick="sendQuickPrompt('How do I download and share badges?')">
                    <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="vertical-align:-1px;margin-right:4px;"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89L17 22l-5-3l-5 3l1.523-9.11"/></svg>
                    Badges & LinkedIn
                </button>
            </div>

            <!-- Input Footer -->
            <div class="ai-chat-footer">
                <input type="text" id="ai-chat-input" placeholder="Type your question..." onkeypress="handleAIChatKeyPress(event)" />
                <button onclick="sendUserAIMessage()" class="ai-send-btn">
                    <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>
                </button>
            </div>
        </div>
    </div>

        <script type="text/javascript">
            var sunIcon = '<svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="vertical-align:-2px;margin-right:6px;"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>';
            var moonIcon = '<svg width="15" height="15" fill="currentColor" viewBox="0 0 24 24" style="vertical-align:-2px;margin-right:6px;"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>';
            var botAvatarSvg = '<div style="width:32px;height:32px;border-radius:50%;background:#6B1A2A;color:#FFFFFF;display:flex;align-items:center;justify-content:center;flex-shrink:0;"><svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2L9.5 9.5 2 12l7.5 2.5L12 22l2.5-7.5L22 12l-7.5-2.5z"/></svg></div>';

            (function() {
                var savedTheme = localStorage.getItem('theme');
                if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                    document.body.classList.add('dark-mode');
                }
            })();

            function updateToggleBtn() {
                var btn = document.getElementById('dark-toggle');
                if (btn) {
                    var isDark = document.body.classList.contains('dark-mode');
                    btn.innerHTML = isDark ? (sunIcon + 'Light Mode') : (moonIcon + 'Dark Mode');
                }
            }

            window.addEventListener('DOMContentLoaded', updateToggleBtn);

            function toggleDark() {
                var isDark = document.body.classList.toggle('dark-mode');
                localStorage.setItem('theme', isDark ? 'dark' : 'light');
                updateToggleBtn();
            }

            /* AI Helpdesk Chatbot Logic */
            function toggleAIChat() {
                var win = document.getElementById('ai-chat-window');
                if (win.style.display === 'none' || !win.style.display) {
                    win.style.display = 'flex';
                    document.getElementById('ai-chat-input').focus();
                } else {
                    win.style.display = 'none';
                }
            }

            function handleAIChatKeyPress(e) {
                if (e.key === 'Enter') {
                    sendUserAIMessage();
                }
            }

            function sendQuickPrompt(promptText) {
                document.getElementById('ai-chat-input').value = promptText;
                sendUserAIMessage();
            }

            function sendUserAIMessage() {
                var input = document.getElementById('ai-chat-input');
                var query = input.value.trim();
                if (!query) return;

                appendChatMessage(query, 'user');
                input.value = '';

                setTimeout(function() {
                    var response = generateAIResponse(query);
                    appendChatMessage(response, 'bot');
                }, 350);
            }

            function appendChatMessage(text, sender) {
                var container = document.getElementById('ai-chat-messages');
                var msgDiv = document.createElement('div');
                msgDiv.style.display = 'flex';
                msgDiv.style.gap = '10px';
                msgDiv.style.alignItems = 'flex-start';

                if (sender === 'user') {
                    msgDiv.style.justifyContent = 'flex-end';
                    msgDiv.innerHTML = '<div class="ai-user-bubble">' + escapeHTML(text) + '</div>';
                } else {
                    msgDiv.innerHTML = botAvatarSvg +
                        '<div class="ai-bot-bubble">' + text + '</div>';
                }

                container.appendChild(msgDiv);
                container.scrollTop = container.scrollHeight;
            }

            function escapeHTML(str) {
                return str.replace(/[&<>'"]/g, 
                    tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag] || tag)
                );
            }

            function generateAIResponse(query) {
                var q = query.toLowerCase();

                if (q.includes('certificate') || q.includes('cert') || q.includes('pass') || q.includes('quiz')) {
                    return '<strong>Official Certificates:</strong> Complete 100% of a course\'s video modules and pass the assessment quiz. Once completed, your certificate can be viewed, printed, or shared directly on LinkedIn from your Dashboard!';
                }
                if (q.includes('leaderboard') || q.includes('xp') || q.includes('rank') || q.includes('points')) {
                    return '<strong>Leaderboard & XP:</strong> Visit the <strong>Leaderboard</strong> tab to view top learners! You earn <strong>+50 XP</strong> for enrolling, <strong>+20 XP</strong> per completed module, and <strong>+100 XP</strong> for scoring 100% on a quiz.';
                }
                if (q.includes('course') || q.includes('enroll') || q.includes('buy') || q.includes('register') || q.includes('free')) {
                    return '<strong>Courses & Enrolling:</strong> Head over to the <strong>Courses</strong> tab to browse 6 creative disciplines (Visual Arts, Digital Art, Photography, Filmmaking, Creative Writing & Music). You can preview free modules before enrolling!';
                }
                if (q.includes('badge') || q.includes('linkedin') || q.includes('award') || q.includes('achievement')) {
                    return '<strong>Badges & Achievements:</strong> Earn badges automatically as you complete modules and post in the forum. Visit your <strong>Dashboard</strong> to download your badge images or share them directly on LinkedIn!';
                }
                if (q.includes('forum') || q.includes('discuss') || q.includes('question') || q.includes('community')) {
                    return '<strong>Community Forum:</strong> Connect with fellow creative learners on the <strong>Forum</strong>! You can create new threads, ask for artwork feedback, and earn the <em>Social Butterfly</em> badge.';
                }
                if (q.includes('dark') || q.includes('light') || q.includes('theme') || q.includes('color')) {
                    return '<strong>Theme Preferences:</strong> You can toggle between Dark Mode and Light Mode anytime using the button at the top right of the navigation bar!';
                }

                return 'Atelier is designed to help you master creative skills at your own pace! Explore <strong>Courses</strong>, track your rank on the <strong>Leaderboard</strong>, earn badges on your <strong>Dashboard</strong>, and get official <strong>Certificates of Completion</strong>.';
            }
        </script>

</body>
</html>
